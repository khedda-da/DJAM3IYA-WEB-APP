PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ── Database ────────────────────────────────────────────────────────────────
# Production: your Supabase Postgres connection string (Project Settings → Database).
# Leave empty locally to use the built-in SQLite file (data/quran_association.db).
# SQLite is NOT usable on Vercel (the filesystem is wiped between invocations).
DATABASE_URL=

# ── Supabase Auth (same approach as LMCS) ───────────────────────────────────
# Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Server-side only. Never expose it to the frontend or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Required in production to create the first administrator on the /setup screen.
# Pick a long random value (no default exists).
SETUP_KEY=

# Login e-mail given to accounts without a real e-mail (username@this-domain).
AUTH_EMAIL_DOMAIN=users.djam3iya.local

# Set to "true" to load demo branches/halaqat/users on an empty database.
SEED_DEMO_DATA=false
